{
  // Type-checks the WIP build's #api/#auth implementations; tsconfig.app.json checks cloud.
  // Remove together with the WIP product.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.wip.tsbuildinfo",
    "paths": {
      "#api/*": ["./src/api/wip/*"],
      "#auth": ["./src/auth/wip/index.ts"]
    }
  }
}
